# Supabase dashboard > Connect > Session pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173

# Provider used when a user has not picked one: anthropic or openai
AI_DEFAULT_PROVIDER=anthropic

# Platform keys are optional when every user supplies their own key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional TypeSafe Jev job matching; leave the key empty to disable
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional LinkedIn job search through the Fantastic.jobs RapidAPI listing; leave the key empty to disable
JOB_LISTINGS_PROVIDER=fantastic_jobs
RAPIDAPI_KEY=

# Base64-encoded 32-byte key: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
